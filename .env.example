# Only set this to override the host every canonical / og:url / og:image is built from.
# Left unset, the build uses Vercel's own VERCEL_PROJECT_PRODUCTION_URL, which is correct for
# both today's .vercel.app host and elagon.ai once that domain is attached to THIS project.
# Setting it to a domain this project does not serve makes every social card 404.
# NEXT_PUBLIC_SITE_URL=https://elagon.ai
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Elagon Website <website@elagon.ai>
CONTACT_TO_EMAIL=jordan@elagon.ai
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
